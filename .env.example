# Copy this file to .env and fill in the values. .env is never committed.
# Phase 1 needs nothing here. Later phases will ask for these one at a time.

# Phase 2: your Notion internal integration secret (starts with "ntn_").
NOTION_TOKEN=

# Phase 4: Google Calendar, read only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
PORT=8787
