{
  "name": "home-window",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/node.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "audit:safety": "node scripts/safety-check.mjs",
    "deploy": "vite build && wrangler deploy"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.157.0"
  }
}
